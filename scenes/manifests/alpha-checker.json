{
    "id": "alpha-checker",
    "title": "Two rooms, a cut-out checker wall",
    "description": "A lit room and a dark room sharing a wall that is a checkerboard of holes (alpha test 0.5, exactly half open): the dark room's light comes only through the holes, so it checks alpha cutouts in GI rays.",
    "tags": ["interior", "leak-test", "alpha-cutout", "textured"],
    "units": "meters",
    "upAxis": "y",
    "parts": [
        { "kind": "procedural", "builder": "alpha-checker" }
    ],
    "cameras": [
        { "name": "lit-room", "position": [0.4, 1.6, 3.6], "target": [4.0, 1.2, 1.6], "fovYDeg": 70 },
        { "name": "dark-room", "position": [7.6, 1.6, 3.6], "target": [4.0, 1.2, 1.6], "fovYDeg": 70 },
        { "name": "dark-room-floor", "position": [7.7, 2.5, 0.3], "target": [5.0, 0.0, 2.4], "fovYDeg": 70 }
    ],
    "lights": [
        { "type": "point", "label": "room-a-lamp", "color": [1, 0.96, 0.88], "intensity": 12, "position": [2, 2.45, 2], "range": 0 }
    ],
    "motions": [
        {
            "id": "light-sweep",
            "label": "room-a-lamp sweeps at 1 m/s across room A and back",
            "target": "light:room-a-lamp",
            "loop": true,
            "keyframes": [
                { "t": 0, "position": [1.0, 1.8, 1.0] },
                { "t": 2.8284, "position": [3.0, 1.8, 3.0] },
                { "t": 5.6569, "position": [1.0, 1.8, 1.0] }
            ]
        },
        {
            "id": "light-step",
            "label": "room-a-lamp jumps every 3 s",
            "target": "light:room-a-lamp",
            "interpolation": "step",
            "loop": true,
            "keyframes": [
                { "t": 0, "position": [1.0, 1.8, 1.0] },
                { "t": 3, "position": [3.0, 1.8, 3.0] },
                { "t": 6, "position": [1.0, 1.8, 1.0] }
            ]
        }
    ],
    "environment": { "type": "none" },
    "volume": { "center": [4.0, 1.4, 2.0], "size": [8.4, 3.0, 4.2], "probeSpacing": 0.5 },
    "nativeCapable": true,
    "referenceCube": { "position": [6.2, 0.5, 0.8] },
    "credits": [
        { "asset": null, "license": "MIT", "attribution": "MIT, this repo." }
    ]
}
