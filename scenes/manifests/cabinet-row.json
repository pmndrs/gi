{
    "id": "cabinet-row",
    "title": "Hollow cabinet row",
    "description": "A kitchen run of hollow cabinets made of 18 mm boards against a wall, to check light does not leak through thin panels or into closed cabinets.",
    "tags": ["interior", "leak-test", "thin-geometry"],
    "units": "meters",
    "upAxis": "y",
    "parts": [
        {
            "kind": "procedural",
            "builder": "cabinet-row",
            "options": {
                "closedFronts": true
            }
        }
    ],
    "cameras": [
        {
            "name": "front-of-the-run",
            "position": [1.6, 1.5, 3.0],
            "target": [1.5, 1.2, 0.3],
            "fovYDeg": 65
        },
        {
            "name": "close-up",
            "position": [1.3, 1.4, 1.8],
            "target": [1.9, 0.9, 0.2],
            "fovYDeg": 55
        },
        {
            "name": "from-the-right",
            "position": [4.5, 1.6, 3.0],
            "target": [1.0, 1.0, 0.3],
            "fovYDeg": 65
        }
    ],
    "lights": [
        {
            "type": "point",
            "label": "ceiling-lamp",
            "color": [1, 0.96, 0.88],
            "intensity": 12,
            "position": [2.4, 2.35, 1.7],
            "range": 12
        }
    ],
    "motions": [
        {
            "id": "light-sweep",
            "label": "ceiling-lamp sweeps at 1 m/s and back",
            "target": "light:ceiling-lamp",
            "loop": true,
            "keyframes": [
                { "t": 0, "position": [0.8, 2.2, 1.7] },
                { "t": 3.2, "position": [4.0, 2.2, 1.7] },
                { "t": 6.4, "position": [0.8, 2.2, 1.7] }
            ]
        },
        {
            "id": "light-step",
            "label": "ceiling-lamp jumps every 3 s",
            "target": "light:ceiling-lamp",
            "interpolation": "step",
            "loop": true,
            "keyframes": [
                { "t": 0, "position": [0.8, 2.2, 1.7] },
                { "t": 3, "position": [4.0, 2.2, 1.7] },
                { "t": 6, "position": [0.8, 2.2, 1.7] }
            ]
        },
        {
            "id": "cabinet-door-swing",
            "label": "A cabinet door opens, stays open 4 s, and closes",
            "target": "object:base-unit-1-door",
            "interpolation": "smooth",
            "loop": true,
            "pivot": [1.2, 0, 0.58],
            "keyframes": [
                { "t": 0, "rotationDeg": [0, 0, 0] },
                { "t": 3, "rotationDeg": [0, 0, 0] },
                { "t": 4.5, "rotationDeg": [0, -100, 0] },
                { "t": 8.5, "rotationDeg": [0, -100, 0] },
                { "t": 10, "rotationDeg": [0, 0, 0] }
            ]
        },
        {
            "id": "cabinet-door-step",
            "label": "The cabinet door jumps open, then shut, every 4 s",
            "target": "object:base-unit-1-door",
            "interpolation": "step",
            "loop": true,
            "pivot": [1.2, 0, 0.58],
            "keyframes": [
                { "t": 0, "rotationDeg": [0, 0, 0] },
                { "t": 4, "rotationDeg": [0, -100, 0] },
                { "t": 8, "rotationDeg": [0, 0, 0] }
            ]
        }
    ],
    "environment": {
        "type": "none"
    },
    "volume": {
        "center": [2.4, 1.3, 1.6],
        "size": [5.0, 2.8, 3.4],
        "probeSpacing": 0.25
    },
    "nativeCapable": true,
    "referenceCube": {
        "position": [3.6, 0.5, 1.4]
    },
    "credits": [
        {
            "asset": null,
            "license": "MIT",
            "attribution": "MIT, this repo."
        }
    ]
}
