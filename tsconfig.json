{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "strict": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["@webgpu/types", "vite/client"],
        "baseUrl": ".",
        "paths": {
            "@pmndrs/gi": ["packages/gi/src/index.ts"],
            "@pmndrs/gi/radiance-cascades": ["packages/gi/src/radiance-cascades.ts"],
            "@pmndrs/gi/radiance-cache": ["packages/gi/src/radiance-cache.ts"],
            "@pmndrs/gi/core": ["packages/gi/src/core.ts"],
            "@pmndrs/gi/ddgi": ["packages/gi/src/ddgi.ts"],
            "@pmndrs/gi/three": ["packages/gi/src/three.ts"],
            "@pathtracer/mlp": ["../pmndrs-pathtracer/packages/mlp/src/index.ts", "packages/ddgi-core/src/techniques/radiance-cache/neural-cache/mlp-unavailable.d.ts"]
        }
    },
    "include": ["packages/*/src", "packages/*/test", "apps/*/src", "examples", "scenes/src", "scenes/check", "tools"],
    "exclude": ["node_modules", "dist", "examples/dist", ".claude", "tools/emsdk"]
}
