{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "strict": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["@webgpu/types", "vite/client"],
        "baseUrl": ".",
        "paths": {
            "@pmndrs/ddgi": ["packages/ddgi/src/index.ts"],
            "@pmndrs/ddgi/core": ["packages/ddgi/src/core.ts"],
            "@pmndrs/ddgi/three": ["packages/ddgi/src/three.ts"]
        }
    },
    "include": ["packages/*/src", "packages/*/test", "apps/*/src", "examples/webgpu/*/src", "tools"],
    "exclude": ["node_modules", "dist", ".claude"]
}
