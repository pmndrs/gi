{
    "name": "@pmndrs/ddgi",
    "version": "0.0.0",
    "description": "WebGPU-native global illumination platform with Dynamic Diffuse Global Illumination (DDGI) as its first technique, plus a three.js adapter",
    "author": "Dennis Smolek <dennis@smolek.dev>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pmndrs/ddgi.git",
        "directory": "packages/ddgi"
    },
    "homepage": "https://github.com/pmndrs/ddgi#readme",
    "bugs": {
        "url": "https://github.com/pmndrs/ddgi/issues"
    },
    "sideEffects": false,
    "keywords": [
        "webgpu",
        "wgsl",
        "three",
        "threejs",
        "global-illumination",
        "ddgi",
        "light-probes"
    ],
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./core": {
            "types": "./dist/core.d.ts",
            "import": "./dist/core.js"
        },
        "./three": {
            "types": "./dist/three.d.ts",
            "import": "./dist/three.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "THIRD_PARTY.md",
        "licenses"
    ],
    "scripts": {
        "build": "vite build && rollup -c rollup.dts.config.mjs && node ../../tools/release/package-files.ts && node scripts/verify-artifacts.mjs",
        "prepublishOnly": "pnpm -w run lint && pnpm -w run typecheck && pnpm -w run test && pnpm run build && pnpm -w run verify:packed --skip-build"
    },
    "peerDependencies": {
        "three": "~0.187.0"
    },
    "peerDependenciesMeta": {
        "three": {
            "optional": true
        }
    },
    "devDependencies": {
        "@pmndrs/ddgi-core": "workspace:*",
        "@pmndrs/ddgi-three": "workspace:*",
        "@types/three": "0.187.0",
        "rollup": "^4.62.2",
        "rollup-plugin-dts": "^6.2.1",
        "three": "0.187.0",
        "vite": "^6.1.0"
    }
}
