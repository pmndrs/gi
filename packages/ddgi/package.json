{
    "name": "@pmndrs/ddgi",
    "version": "0.0.0",
    "description": "WebGPU-native global illumination platform with Dynamic Diffuse Global Illumination (DDGI) as its first technique, plus a three.js adapter",
    "author": "Dennis Smolek <dennis@smolek.dev>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pmndrs/ddgi.git",
        "directory": "packages/ddgi"
    },
    "sideEffects": false,
    "keywords": ["webgpu", "wgsl", "three", "threejs", "global-illumination", "ddgi", "light-probes"],
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./core": {
            "types": "./dist/core.d.ts",
            "import": "./dist/core.js"
        },
        "./three": {
            "types": "./dist/three.d.ts",
            "import": "./dist/three.js"
        },
        "./radiance-cache": {
            "types": "./dist/radiance-cache.d.ts",
            "import": "./dist/radiance-cache.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "vite build && rollup -c rollup.dts.config.mjs && node scripts/verify-artifacts.mjs"
    },
    "peerDependencies": {
        "three": "~0.187.0"
    },
    "peerDependenciesMeta": {
        "three": {
            "optional": true
        }
    },
    "devDependencies": {
        "@pmndrs/ddgi-core": "workspace:*",
        "@pmndrs/ddgi-three": "workspace:*",
        "@types/three": "0.187.0",
        "rollup": "^4.62.2",
        "rollup-plugin-dts": "^6.2.1",
        "three": "0.187.0",
        "vite": "^6.1.0"
    }
}
