{
    "name": "webgpu-ddgi",
    "version": "0.0.0",
    "private": true,
    "description": "Workspace root for @pmndrs/gi: a WebGPU-native GI platform with DDGI as its first technique. The published package lives in packages/ddgi.",
    "license": "MIT",
    "type": "module",
    "packageManager": "pnpm@10.23.0",
    "scripts": {
        "preinstall": "node tools/linked-siblings.ts",
        "siblings:fetch": "node tools/linked-siblings.ts --fetch",
        "dev": "pnpm --filter @pmndrs/ddgi-viewer dev",
        "build": "pnpm --filter @pmndrs/gi build",
        "verify:packed": "node tools/release/verify-packed.ts",
        "build:apps": "pnpm --filter @pmndrs/ddgi-viewer --filter @pmndrs/ddgi-example-hello build",
        "examples": "vite --config examples/vite.config.ts",
        "examples:build": "vite build --config examples/vite.config.ts",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:release": "vitest run --config tools/release/vitest.config.ts",
        "test:gpu": "node tools/gpu/run.ts",
        "device:serve": "node tools/gpu/serve-lan.ts",
        "assets:fetch": "node tools/assets/fetch.ts",
        "bvh:wasm": "node packages/bvh/native/build-wasm.ts",
        "scenes:export": "pnpm --filter @pmndrs/ddgi-scenes export"
    },
    "linkedSiblings": {
        "@pmndrs/denoiser-ffx": {
            "repo": "https://github.com/pmndrs/denoiser.git",
            "commit": "022e02b3c1417f9d2011f90824f932afd8430d60",
            "clone": "../pmndrs-denoiser",
            "path": "packages/denoiser-ffx",
            "built": ["dist/index.mjs", "dist/index.d.ts"],
            "build": [
                ["corepack", "yarn", "install"],
                ["corepack", "yarn", "workspace", "@pmndrs/denoiser-core", "build"],
                ["corepack", "yarn", "workspace", "@pmndrs/denoiser-ffx", "build"]
            ]
        }
    },
    "devDependencies": {
        "@babylonjs/core": "9.33.2",
        "@eslint/js": "^9.18.0",
        "@pmndrs/denoiser-ffx": "link:../pmndrs-denoiser/packages/denoiser-ffx",
        "@pmndrs/upscaler": "0.5.0",
        "@types/node": "24.19.2",
        "@types/three": "0.187.0",
        "@webgpu/types": "^0.1.64",
        "eslint": "^9.18.0",
        "globals": "^15.14.0",
        "three": "0.187.0",
        "three-gpu-pathtracer": "0.0.28",
        "three-mesh-bvh": "0.9.18",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.20.0",
        "vite": "^6.1.0",
        "vitest": "^3.0.0"
    }
}
